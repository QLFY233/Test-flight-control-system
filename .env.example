# 试飞控制系统 — 环境变量模板
# 复制为 .env 并填入真实值（.env 已 gitignore）
# 详细说明见 docs/specs/总体/2026-07-01-总体架构-design.md §4

# --- LLM Provider ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- 讯飞语音 (STT) ---
XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=

# --- 讯飞语音 (TTS) ---
XF_API_PASSWORD=

# --- 后端 A α 翻译器后端 ---
ALPHA_BACKEND=llm
# ALPHA_BACKEND=small  # 远期蒸馏小模型

# --- 后端 B 小模型后端 ---
SMALL_MODEL_BACKEND=stub
# SMALL_MODEL_BACKEND=onnx  # 阶段4

# --- 数据库路径 (可选) ---
# FLIGHT_DB_PATH=data/flight_control.db
